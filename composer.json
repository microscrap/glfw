{
    "name": "microscrap/glfw",
    "description": "LibGLFW Bindings for The PHP GLFW Extension",
    "type": "library",
    "version": "0.7.0",
    "keywords": [
        "framework",
        "scrapyard-io",
        "glfw",
        "bindings"
    ],
    "license": "MIT",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/microscrap/glfw/0.7.x/overview",
    "support": {
        "docs": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/microscrap/glfw/0.7.x/overview",
        "source": "https://github.com/microscrap/glfw",
        "issues": "https://github.com/microscrap/glfw/issues"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-glfw": "^0.5.0"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "Microscrap\\Bindings\\GLFW\\": "src/"
        },
        "files": [
            "src/Helpers/glfw-init.php",
            "src/Helpers/glfw-error.php",
            "src/Helpers/glfw-window.php",
            "src/Helpers/glfw-monitor.php",
            "src/Helpers/glfw-input.php",
            "src/Helpers/glfw-context.php",
            "src/Helpers/glfw-gl.php",
            "src/Helpers/glfw-vulkan.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.7.x-dev",
            "dev-main": "0.7.x-dev",
            "dev-0.7.x": "0.7.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
